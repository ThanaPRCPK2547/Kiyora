{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/app.py"
    },
    {
      "source": "/records:path*",
      "destination": "/app.py"
    },
    {
      "source": "/health",
      "destination": "/app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/public/index.html"
    }
  ]
}
